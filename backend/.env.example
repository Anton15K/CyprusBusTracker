# Database
DB_URL=postgresql+asyncpg://cyprusbus:cyprusbus@localhost:5432/cyprusbus
DB_ECHO=false

# GTFS data paths (relative to repo root by default)
GTFS_SOURCE_FOLDER=google_transit_files
GTFS_TARGET_FOLDER=otp_data
GTFS_OSM_FOLDER=osm_data

# GTFS Realtime API
GTFS_REALTIME_URL=http://20.19.98.194:8328/Api/api/gtfs-realtime

# OTP
OTP_URL=http://localhost:8080/otp/gtfs/v1
OTP_JAR=otp-shaded-2.7.0.jar
OTP_PORT=8085
MANAGE_OTP=true

# Scheduler (daily GTFS reload time, Cyprus TZ)
RELOAD_HOUR=3
RELOAD_MINUTE=0

# Frontend paths (resolved from repo root)
TEMPLATES_DIR=frontend/templates
STATIC_DIR=frontend/static
